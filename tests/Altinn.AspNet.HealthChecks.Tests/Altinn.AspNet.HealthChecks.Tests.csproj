<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Test method names read better without CA warnings; xUnit analyzer covers the rest. -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference implementation of the HealthChecks UI JSON format; used only to verify
         that HealthCheckJsonResponseWriter stays byte-identical to it. -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Altinn.AspNet.HealthChecks\Altinn.AspNet.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Altinn.AspNet.HealthChecks.OpenTelemetry\Altinn.AspNet.HealthChecks.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\Altinn.AspNet.HealthChecks.Warmup\Altinn.AspNet.HealthChecks.Warmup.csproj" />
  </ItemGroup>

</Project>
