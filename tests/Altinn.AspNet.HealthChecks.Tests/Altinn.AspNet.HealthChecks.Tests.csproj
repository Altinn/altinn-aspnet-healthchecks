<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors the TFMs the packages ship for, so every supported framework is actually
         exercised and a dependency update cannot break net8.0/net9.0 behind a green CI. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- xunit.v3 test projects are self-runnable executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Test method names read better without CA warnings; xUnit analyzer covers the rest. -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
    <!-- Run on Microsoft Testing Platform (xunit.v3's native runner) instead of VSTest.
         UseMicrosoftTestingPlatformRunner keeps VSTest-based IDE test explorers working. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Altinn.AspNet.HealthChecks\Altinn.AspNet.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Altinn.AspNet.HealthChecks.OpenTelemetry\Altinn.AspNet.HealthChecks.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\Altinn.AspNet.HealthChecks.Probes\Altinn.AspNet.HealthChecks.Probes.csproj" />
    <ProjectReference Include="..\..\src\Altinn.AspNet.HealthChecks.Warmup\Altinn.AspNet.HealthChecks.Warmup.csproj" />
  </ItemGroup>

</Project>
