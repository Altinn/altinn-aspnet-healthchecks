<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Build.props, $(MSBuildThisFileDirectory)..))" />

  <!--
    Shared defaults for all packable projects under src/. Adding a new companion package
    (e.g. Altinn.AspNet.HealthChecks.Npgsql) needs only a folder with a csproj declaring its
    TargetFrameworks and dependencies, a README.md, and an entry in the .slnx — AssemblyName
    and PackageId default to the project file name, and the publish workflow packs every
    packable project in the solution.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- All packages share the root namespace, so consumers add a package without new usings. -->
    <RootNamespace>Altinn.AspNet.HealthChecks</RootNamespace>
    <!-- Default for local packs; CI overrides with -p:Version from the git tag.
         Kept in sync with the released version by release-please. -->
    <Version>0.2.0</Version> <!-- x-release-please-version -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Package validation. Without a baseline it verifies that the TFMs inside a package are
    API-compatible with each other. Setting PackageValidationBaselineVersion additionally
    diffs the build against that released package and fails on a breaking change — which is
    what makes it safe to let dependency updates merge and release unattended.

    Set it to the version that just shipped, immediately AFTER shipping it — never during a
    release that contains intentional breaks, since the baseline would still be the older version
    that release deliberately breaks from. See MAINTAINERS.md.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion> -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
